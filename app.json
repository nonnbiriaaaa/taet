{
  "expo": {
    "name": "健康管理",
    "slug": "health-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1A7A4A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.healthapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A7A4A"
      },
      "package": "com.healthapp"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "scheme": "health-app"
  }
}
